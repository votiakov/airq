# Optional overrides for `docker compose up`. Copy to .env (git-ignored) and edit.
# Every value has a working default, so the stack runs without this file.

# Host ports (change them if something else already listens there).
AIRQ_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686
MOCK_PORT=8090

# Local-only credentials. Postgres is not published to the host; these exist so the
# roles are real, not so the defaults are secret. Use a secret store anywhere else.
POSTGRES_PASSWORD=postgres
AIRQ_MIGRATOR_PASSWORD=migrator
AIRQ_APP_PASSWORD=app
GRAFANA_ADMIN_PASSWORD=admin

# Service settings passed through by compose (see README "Configuration" for all).
LOG_LEVEL=info
# Only needed for Open-Meteo's commercial plans; the free API needs no key.
UPSTREAM_API_KEY=
